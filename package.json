{
  "name": "openvern",
  "productName": "OpenVern",
  "version": "0.2.0",
  "private": true,
  "description": "OpenVern: a desktop app to chat with LLMs about your local code projects and review the edits they propose.",
  "author": "Stefanos Michelakis",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch --clear-screen=false --tsconfig tsconfig.node.json src/server/dev.ts",
    "dev:web": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"vite --config vite.web.config.ts\"",
    "dev": "concurrently -k -n server,electron -c yellow,cyan \"npm:dev:server\" \"electron-vite dev\"",
    "build": "electron-vite build",
    "preview": "electron-vite build && OPENVERN_DATA_DIR=./.dev-data-preview electron-vite preview --skipBuild",
    "dist": "electron-vite build && electron-builder --linux AppImage",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "secrets:scan": "gitleaks git --config .gitleaks.toml --redact --no-banner && gitleaks dir --config .gitleaks.toml --redact --no-banner .",
    "e2e": "bash scripts/e2e/run-web.sh && bash scripts/e2e/run-electron.sh",
    "e2e:web": "bash scripts/e2e/run-web.sh",
    "e2e:electron": "bash scripts/e2e/run-electron.sh",
    "format": "biome check --write .",
    "try:openrouter": "tsx --tsconfig tsconfig.node.json scripts/try-openrouter.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@tanstack/react-query": "5.105.0",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "eventsource-parser": "4.1.3",
    "hono": "4.13.14",
    "ignore": "7.0.14",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "7.18.5",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
